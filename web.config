{
  // ─── 服务配置（本文件支持 // 注释，修改后保存即可自动热加载）──────────
  "port": 82,                         // 监听端口
  "bind": "0.0.0.0",                  // 绑定地址，0.0.0.0 = 局域网可访问
  "title": "Easy Wiki · 文档浏览",     // 页面标题

  // ─── 文档编辑密码：非空则允许前端「编辑」，留空字符串则禁用编辑 ────────
  "editPassword": "123456",

  // ─── Tab 模式：
  //     "single"  - 单标签，每次点击替换当前标签
  //     "perType" - 按文件类型分标签，同类型文件共享一个标签
  //     "multi"   - 多标签，最多 maxTabs 个，超过时 FIFO 淘汰最旧的
  "tabMode": "multi",
  "maxTabs": 10,

  // ─── 文档根目录列表 ─────────────────────────────────────────────────
  "roots": [
    { "name": "示例", "path": "E:/projects/easy-wiki/docs" },
	{ "name": "综能能源解决方案优化", "path": "E:/projects/wiki/.tmp/综能能源解决方案优化" }
    
  ],

  // ─── 忽略规则 ───────────────────────────────────────────────────────
  "ignore": [
    "node_modules", ".git", ".vitepress", ".idea", ".omc", ".tmp", ".claude",
    "log", "dist", "target", "__pycache__", "*.iml"
  ],
  "ignoreHidden": true,

  // ─── 前端自动刷新间隔（秒），0 = 关闭 ────────────────────────────────
  "autoRefreshSeconds": 0
}
